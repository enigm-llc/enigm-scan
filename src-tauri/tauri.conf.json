{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enigm Scan",
  "version": "1.0.0",
  "identifier": "io.enigm.scan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Enigm Scan",
        "width": 1120,
        "height": 700,
        "minWidth": 1024,
        "minHeight": 660,
        "create": false,
        "incognito": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local mobile threat analysis",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {}
}
